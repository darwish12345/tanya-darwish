# Salin fail ini ke .env.local dan isi nilai anda. JANGAN commit .env.local ke GitHub.

# Wajib: kunci API percuma dari https://console.groq.com/keys
GROQ_API_KEY=

# Pilihan: tukar model (lalai: openai/gpt-oss-120b)
# Model lain yang menyokong tool calling: llama-3.3-70b-versatile, openai/gpt-oss-20b
GROQ_MODEL=

# Pilihan: notifikasi Telegram bila pelawat tinggalkan mesej
# 1. Cipta bot melalui @BotFather di Telegram, salin token
# 2. Hantar satu mesej kepada bot anda, kemudian buka
#    https://api.telegram.org/bot<TOKEN>/getUpdates untuk dapatkan chat id anda
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wajib untuk agent peribadi Telegram, peringatan & laporan harian:
# rahsia ciptaan anda sendiri, HURUF dan NOMBOR sahaja, minimum 16 aksara
AGENT_SECRET=

# Pilihan (laptop sahaja): simpan data dalam folder .data/ walaupun mod produksi
# STORAN=fail

# Wajib di produksi: memori agent (percuma di https://upstash.com, tanpa kad kredit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alamat laman (lalai: URL Netlify automatik). Digunakan oleh kerja latar QStash.
# LAMAN_URL=https://tanya-darwish.netlify.app

# ── Peringatan tepat pada minit (percuma, tanpa kad): https://console.upstash.com/qstash
# Tanpa ini, peringatan dihantar oleh cron (dalam masa 15 minit).
QSTASH_TOKEN=
# QSTASH_URL=https://qstash.upstash.io   (tukar hanya jika akaun anda di rantau lain)

# ── Carian kerja harian (JSearch: Indeed, LinkedIn, Glassdoor, JobStreet...)
# RapidAPI → langgan JSearch pelan "Basic" (percuma, 200 permintaan/bulan): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# JSEARCH_PROVIDER=rapidapi   (atau openwebninja)

# ── Hantar permohonan dari Gmail anda (hanya selepas anda tekan "Hantar" di Telegram)
# Perlu 2-Step Verification, kemudian cipta App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Tempah interview ke Google Calendar (akaun servis, percuma)
# Cipta service account di Google Cloud, aktifkan Calendar API, muat turun kunci JSON,
# kemudian kongsi kalendar anda dengan emel service account ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# ── Profil
GITHUB_USERNAME=darwish12345
# Maklumat hubungan untuk resume (TIDAK disimpan dalam repo awam)
# RESUME_EMEL=        (lalai: GMAIL_USER)
RESUME_TELEFON=
RESUME_LOKASI=
