# Salin fail ini ke .env.local dan isi nilai anda. JANGAN commit .env.local ke GitHub.

# Wajib: kunci API percuma dari https://console.groq.com/keys
GROQ_API_KEY=

# Pilihan: tukar model (lalai: openai/gpt-oss-120b)
# Model lain yang menyokong tool calling: llama-3.3-70b-versatile, openai/gpt-oss-20b
GROQ_MODEL=

# Pilihan: notifikasi Telegram bila pelawat tinggalkan mesej
# 1. Cipta bot melalui @BotFather di Telegram, salin token
# 2. Hantar satu mesej kepada bot anda, kemudian buka
#    https://api.telegram.org/bot<TOKEN>/getUpdates untuk dapatkan chat id anda
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wajib untuk agent peribadi Telegram, peringatan & laporan harian:
# rahsia ciptaan anda sendiri, HURUF dan NOMBOR sahaja, minimum 16 aksara
AGENT_SECRET=

# Pilihan (laptop sahaja): simpan data dalam folder .data/ walaupun mod produksi
# STORAN=fail

# Wajib di produksi: memori agent (percuma di https://upstash.com, tanpa kad kredit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
